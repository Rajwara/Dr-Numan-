---
const { cite } = Astro.props;
---
<figure class="pq reveal">
  <blockquote><slot /></blockquote>
  {cite && <figcaption>{cite}</figcaption>}
</figure>
<style>
  .pq { margin: 2.2em 0; padding: 0; border: 0; }
  .pq blockquote { margin: 0; padding: 0; border: 0; font-family: var(--serif); font-style: italic; font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1.15; letter-spacing: -0.02em; color: var(--ink); }
  .pq blockquote::before { content: '“'; color: var(--accent); }
  .pq figcaption { margin-top: 14px; font-size: .9rem; color: var(--muted); font-style: normal; }
</style>
