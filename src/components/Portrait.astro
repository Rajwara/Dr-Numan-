---
/**
 * Hero portrait. Set `src` to a cut-out / studio portrait (B&W or muted, ≥2400px wide).
 * Until it is supplied, renders a sculpted monochrome silhouette with an amber rim light
 * (the mood of the reference design) so the composition can be reviewed.
 */
const { src, alt = 'Portrait of Dr. Nauman Niaz' } = Astro.props;
---
{src ? (
  <img class="portrait" src={src} alt={alt} fetchpriority="high" />
) : (
  <svg class="portrait" viewBox="0 0 800 900" role="img" aria-label="Portrait placeholder">
    <defs>
      <radialGradient id="pg-skin" cx="50%" cy="30%" r="70%">
        <stop offset="0" stop-color="#3a3a3e" />
        <stop offset=".55" stop-color="#151517" />
        <stop offset="1" stop-color="#050505" />
      </radialGradient>
      <linearGradient id="pg-rim" x1="0" x2="1">
        <stop offset="0" stop-color="#ffb066" stop-opacity="0" />
        <stop offset=".5" stop-color="#e8711c" />
        <stop offset="1" stop-color="#ffb066" stop-opacity="0" />
      </linearGradient>
      <radialGradient id="pg-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#e8711c" stop-opacity=".55" />
        <stop offset="1" stop-color="#e8711c" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="pg-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset=".72" stop-color="#fff" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <mask id="pg-mask"><rect width="800" height="900" fill="url(#pg-fade)" /></mask>
    </defs>
    <ellipse cx="400" cy="300" rx="240" ry="200" fill="url(#pg-glow)" />
    <g mask="url(#pg-mask)">
      <path fill="url(#pg-skin)" d="M400 118c-78 0-132 56-134 142-1 34 4 64 12 90-12-2-20 8-17 24 4 22 14 40 28 44 10 34 28 62 50 80l3 52c-10 20-40 34-96 52-86 28-168 52-206 128C22 774 14 840 12 900h776c-2-60-10-126-28-170-38-76-120-100-206-128-56-18-86-32-96-52l3-52c22-18 40-46 50-80 14-4 24-22 28-44 3-16-5-26-17-24 8-26 13-56 12-90-2-86-56-142-134-142Z" />
      <path fill="none" stroke="url(#pg-rim)" stroke-width="3" stroke-linecap="round" d="M276 236c10-70 60-110 124-110s114 40 124 110" opacity=".9" />
      <path fill="none" stroke="#fff" stroke-opacity=".07" stroke-width="2" d="M338 600c18 12 40 18 62 18s44-6 62-18" />
    </g>
  </svg>
)}
<style>
  .portrait { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
</style>
