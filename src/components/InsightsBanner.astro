---
/**
 * Insights page banner, adapted from the supplied book banner (banner.html):
 * a dark band with a serif headline, then a stage of image cards joined by thin
 * connector lines. The centre card is the featured post (links to it); the side
 * cards are decorative artwork. Card positions are in px on a 1475 px wide stage,
 * scaled with container query units, exactly as in the original.
 */
import { postImage } from '../scripts/util';
import Button from './Button.astro';

interface Props {
  featured?: { id: string; data: { title: string; category: string; image?: string; imageAlt?: string } };
}
const { featured } = Astro.props;

const side = [
  { src: '/images/insight-history.webp', x: 2, y: 0, w: 176, h: 225, px: 16, py: 21, kind: 'outline' },
  { src: '/images/insight-cricket.webp', x: 219, y: 116, w: 196, h: 249, px: 21, py: 21, kind: 'outline' },
  { src: '/images/pillar-publications.webp', x: 64, y: 377, w: 165, h: 202, px: 20, py: 20, kind: 'filled' },
  { src: '/images/insight-medicine.webp', x: 1060, y: 83, w: 176, h: 228, px: 26, py: 31, kind: 'outline' },
  { src: '/images/programme-ptv.webp', x: 1282, y: 0, w: 191, h: 249, px: 21, py: 26, kind: 'glow' },
  { src: '/images/insight-guest.webp', x: 1215, y: 326, w: 181, h: 224, px: 20, py: 20, kind: 'filled' },
];
const style = (c: { x: number; y: number; w: number; h: number; px: number; py: number }) =>
  `--x:${c.x};--y:${c.y};--w:${c.w};--h:${c.h};--px:${c.px};--py:${c.py}`;
---
<section class="ib" aria-labelledby="ib-title">
  <div class="ib__head">
    <span class="ib__eyebrow">Insights</span>
    <h1 id="ib-title" class="ib__title" data-split>Opinion &amp; essays on cricket, <br class="ib__br" /><em>its history</em> &amp; the medicine of sport</h1>
    {featured && <Button href={`/insights/${featured.id}/`} variant="light">Read the latest</Button>}
  </div>

  <div class="ib__wrap">
    <div class="ib__stage">
      <svg class="ib__lines" viewBox="0 0 1475 697" aria-hidden="true">
        <path d="M178 60H282a20 20 0 0 1 20 20V116" />
        <path d="M415 228H518" />
        <path d="M316 365V455a20 20 0 0 1-20 20H229" />
        <path d="M957 359H989a20 20 0 0 1 20 20V412a20 20 0 0 0 20 20H1215" />
        <path d="M1148 311V370a12 12 0 0 1-12 12H1097a12 12 0 0 0-12 12V432" />
        <path d="M1155 83V65a20 20 0 0 1 20-20H1282" />
      </svg>

      {side.map((c, i) => (
        <div class:list={['ib__card', 'ib__side', `ib__card--${c.kind}`]} style={style(c)} aria-hidden="true">
          <div class="ib__float" style={`animation-delay:${-i * 1.3}s`}>
            <img src={c.src} alt="" loading="lazy" decoding="async" />
          </div>
        </div>
      ))}

      {featured ? (
        <a class="ib__card ib__main ib__card--filled" style={style({ x: 518, y: 140, w: 439, h: 557, px: 20, py: 20 })} href={`/insights/${featured.id}/`} data-cursor="Read">
          <img src={postImage(featured.data)} alt={featured.data.imageAlt ?? ''} decoding="async" />
          <span class="ib__cap">
            <span class="ib__cat">Featured · {featured.data.category}</span>
            <span class="ib__ptitle">{featured.data.title}</span>
          </span>
        </a>
      ) : (
        <div class="ib__card ib__main ib__card--filled" style={style({ x: 518, y: 140, w: 439, h: 557, px: 20, py: 20 })} aria-hidden="true">
          <img src="/images/insight-history.webp" alt="" />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .ib {
    --band: #120f0c;
    --line: rgba(232, 113, 28, .45);
    --card-fill: rgba(255, 236, 220, .07);
    padding-top: clamp(118px, 13vw, 160px);
    overflow: hidden;
    background: linear-gradient(var(--band) 80%, transparent 80%) no-repeat;
    position: relative;
  }
  .ib::before {
    content: ''; position: absolute; left: 50%; top: 30%; width: 70vw; height: 50%; translate: -50% 0; pointer-events: none;
    background: radial-gradient(closest-side, rgba(232, 113, 28, .18), transparent); filter: blur(30px);
  }

  /* heading */
  .ib__head { position: relative; text-align: center; padding: 0 var(--gutter); display: grid; justify-items: center; gap: 22px; }
  .ib__eyebrow { font-size: .8rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: #c9c3bd; }
  .ib__title { max-width: 820px; margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(2.3rem, 4.6vw, 3.9rem); line-height: 1.12; letter-spacing: -0.01em; color: #fff; }
  .ib__title em { color: var(--accent); }

  /* stage: px at 1475 wide, scaled */
  .ib__wrap { max-width: 1475px; margin: -30px auto 0; container-type: inline-size; position: relative; }
  .ib__stage { position: relative; width: 100%; aspect-ratio: 1475 / 697; --u: calc(100cqw / 1475); }
  .ib__lines { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: var(--line); stroke-width: 1; }
  .ib__lines path { stroke-dasharray: 600; stroke-dashoffset: 600; animation: ib-draw 2.2s 1s cubic-bezier(.22,1,.36,1) forwards; }
  @keyframes ib-draw { to { stroke-dashoffset: 0; } }

  .ib__card {
    position: absolute;
    left: calc(var(--x) * var(--u)); top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u)); height: calc(var(--h) * var(--u));
    padding: calc(var(--py, 20) * var(--u)) calc(var(--px, 20) * var(--u));
    border-radius: 10px;
    animation: ib-in 1.2s cubic-bezier(.22,1,.36,1) both;
  }
  .ib__side:nth-of-type(1) { animation-delay: .35s; } .ib__side:nth-of-type(2) { animation-delay: .5s; }
  .ib__side:nth-of-type(3) { animation-delay: .65s; } .ib__side:nth-of-type(4) { animation-delay: .45s; }
  .ib__side:nth-of-type(5) { animation-delay: .6s; } .ib__side:nth-of-type(6) { animation-delay: .75s; }
  .ib__main { animation-delay: .2s; }
  @keyframes ib-in { from { opacity: 0; transform: translateY(40px) scale(.96); } }

  .ib__card img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .ib__float { width: 100%; height: 100%; animation: ib-float 7s ease-in-out infinite; }
  @keyframes ib-float { 50% { transform: translateY(-6px); } }

  .ib__card--outline { background: var(--band); border: 1px solid var(--line); }
  .ib__card--filled { background: var(--card-fill); }
  .ib__card--glow { border: 1px solid var(--line); background: linear-gradient(207deg, rgba(232,113,28,.55), rgba(217,217,217,.18) 20%, rgba(217,217,217,0) 86%); }

  /* main card = featured post */
  .ib__main { display: block; box-shadow: 0 40px 80px -40px rgba(0,0,0,.6); transition: transform .6s var(--ease); }
  .ib__main:hover { transform: translateY(-6px); }
  .ib__main img { transition: transform 1.2s var(--ease), filter .6s; }
  .ib__main { overflow: hidden; }
  .ib__main:hover img { transform: scale(1.03); }
  .ib__cap {
    position: absolute; left: calc(20 * var(--u)); right: calc(20 * var(--u)); bottom: calc(20 * var(--u));
    padding: 18px 18px 16px; border-radius: 0 0 4px 4px; display: grid; gap: 6px;
    background: linear-gradient(0deg, rgba(12,10,8,.92), rgba(12,10,8,0)); color: #fff;
  }
  .ib__cat { font-size: .7rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--accent-glow); }
  .ib__ptitle { font-size: clamp(1rem, 1.5vw, 1.3rem); font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; }

  @media (max-width: 1100px) { .ib__wrap { margin-top: 10px; } }

  @media (max-width: 767px) {
    .ib { background: linear-gradient(var(--band) 70%, transparent 70%) no-repeat; }
    .ib__br { display: none; }
    /* side cards are too small to read here, so only the main card stays */
    .ib__stage { aspect-ratio: auto; padding: 36px 20px 0; }
    .ib__lines, .ib__side { display: none; }
    .ib__main { position: relative; left: auto; top: auto; width: min(100%, 360px); height: auto; aspect-ratio: 439 / 557; margin: 0 auto; padding: 14px; }
    .ib__cap { left: 14px; right: 14px; bottom: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ib__card, .ib__float, .ib__lines path { animation: none; stroke-dashoffset: 0; }
  }
</style>
