---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LiquidLoader from '../components/LiquidLoader.astro';
import { site } from '../data/site';

/** Every page passes its own title, meta description and Open Graph image (Read Me, rule 3). */
interface Props { title: string; description: string; ogImage?: string; type?: 'website' | 'article'; noindex?: boolean }
const { title, description, ogImage = '/og/default.png', type = 'website', noindex = false } = Astro.props;
const fullTitle = title === site.name ? `${site.name}: ${site.descriptor.replace(/\.$/, '')}` : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(ogImage, Astro.site);
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#e7e7e9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300..700;1,400&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion-on');
        // loader plays on the first page of a visit only
        var seen = false;
        try { seen = sessionStorage.getItem('nn-intro') === '1'; } catch (e) {}
        d.classList.add(seen ? 'loader-skip' : 'is-loading');
        // safety nets: never leave content hidden if scripts fail to load
        setTimeout(function () { if (!d.classList.contains('motion-ready')) d.classList.add('motion-off'); }, 6000);
        setTimeout(function () { var l = document.getElementById('loader'); if (l && !window.__loaderDone) { l.remove(); d.classList.remove('is-loading'); } }, 12000);
      })();
    </script>
  </head>
  <body>
    <LiquidLoader />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
