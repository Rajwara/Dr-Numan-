---
/**
 * HOME v2: a more organised alternative to the current home page, for comparison.
 * Follows the spreadsheet's Home order: hero → credentials → four pillars →
 * latest Conversations + Insights → featured book → memorabilia → (voices) → contact.
 * Not linked in the menu; noindex and excluded from the sitemap until chosen.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Media from '../components/Media.astro';
import Arrow from '../components/Arrow.astro';
import { site, postnominals, credentials, pillars, books, timeline, memorabilia, quotes, defaultImages, honours } from '../data/site';
import { byDate, fmtDate, readingTime, postImage } from '../scripts/util';

const episodes = (await getCollection('conversations')).sort(byDate).slice(0, 3);
const posts = (await getCollection('insights')).sort(byDate).slice(0, 3);
const featuredBook = books.find((b) => b.featured) ?? books[0];
const moreBooks = books.filter((b) => b !== featuredBook).slice(0, 3);
const isYear = (v: string) => /^\d{4}$/.test(v);
const thumb = (d: { thumbnail?: string; youtubeId?: string }) =>
  d.thumbnail || (d.youtubeId ? `https://i.ytimg.com/vi/${d.youtubeId}/hqdefault.jpg` : defaultImages.episode);

// a short, even career snapshot: one milestone per field, newest last
const snapshotYears = ['1992', '1999', '2002', '2005', '2014', '2024'];
const snapshot = snapshotYears
  .map((y) => timeline.find((t) => t.year === y))
  .filter((t): t is (typeof timeline)[number] => Boolean(t));
const award = honours[0];
const realMemo = memorabilia.filter((m) => m.image); // real collection photos, once supplied
---
<Base
  title={site.name}
  description={`${site.name}: ${site.descriptor} Broadcasting, books, medicine, academia and the Conversations series.`}
  noindex
>
  <!-- 1 · HERO: split, text left / portrait right -->
  <section class="v2-hero">
    <div class="container v2-hero__grid">
      <div class="v2-hero__text">
        <span class="eyebrow reveal">Physician · Broadcaster · Author · Historian</span>
        <h1 class="display v2-hero__title" data-split>Dr. Nauman <em>Niaz</em></h1>
        <p class="v2-hero__quals reveal">{postnominals.join(' • ')}</p>
        <p class="lede reveal">{site.shortBio}</p>
        <div class="btn-row reveal">
          <Button href="/about/">About Dr. Niaz</Button>
          <a class="btn btn--ghost" href={episodes[0] ? `/conversations/${episodes[0].id}/` : '/conversations/'}>Latest Conversation</a>
        </div>
      </div>
      <figure class="v2-hero__photo" data-clip>
        <picture>
          <source type="image/webp" srcset="/images/hero-mobile-640.webp 640w, /images/hero-mobile-941.webp 941w" sizes="(max-width: 860px) 90vw, 40vw" />
          <img src="/images/hero-mobile-941.jpg" alt="Portrait of Dr. Nauman Niaz" width="941" height="1672" fetchpriority="high" />
        </picture>
        {award && (
          <figcaption class="v2-hero__badge glass">
            <span class="v2-hero__badge-k">{award.year}</span>
            <span>{award.title}<br /><span class="muted">{award.body}</span></span>
          </figcaption>
        )}
      </figure>
    </div>

    <!-- 2 · CREDENTIALS -->
    <div class="container">
      <ul class="v2-creds" data-stagger>
        {credentials.map((c) => (
          <li><strong data-count={isYear(c.value) ? undefined : ''}>{c.value}</strong><span>{c.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3 · FOUR PILLARS -->
  <section class="section v2-sec">
    <div class="container">
      <header class="v2-head">
        <span class="v2-head__n">01</span>
        <div><span class="eyebrow">His work</span><h2 class="h2" data-split>Four disciplines, <em>one career</em></h2></div>
      </header>
      <div class="grid grid-4" data-stagger>
        {pillars.map((p, i) => (
          <a class="card v2-pillar zoom" href={p.href} data-cursor="Explore">
            <Media src={p.image} alt="" label={`${p.title} image`} ratio="4 / 3" dark />
            <div class="card__body">
              <span class="v2-pillar__n">0{i + 1}</span>
              <h3 class="h3">{p.title}</h3>
              <p class="muted">{p.text}</p>
              <span class="v2-more">Go to {p.title} <Arrow dir="right" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 + 5 · LATEST: Conversations | Insights, side by side -->
  <section class="section v2-sec v2-latest">
    <div class="container">
      <header class="v2-head">
        <span class="v2-head__n">02</span>
        <div><span class="eyebrow">Recently published</span><h2 class="h2" data-split>The <em>latest</em></h2></div>
      </header>
      <div class="v2-latest__grid">
        <div class="v2-col">
          <div class="v2-col__head"><h3 class="h3">Conversations</h3><a class="link-arrow" href="/conversations/">All episodes →</a></div>
          <ul class="v2-list" data-stagger>
            {episodes.map((ep) => (
              <li>
                <a class="v2-item" href={`/conversations/${ep.id}/`} data-cursor={ep.data.format === 'Video' ? 'Watch' : 'Listen'}>
                  <span class="v2-item__img"><img src={thumb(ep.data)} alt="" loading="lazy" /><i class="v2-item__play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg></i></span>
                  <span class="v2-item__body">
                    <span class="v2-item__kick">{ep.data.guest} · {ep.data.format}</span>
                    <span class="v2-item__title">{ep.data.title}</span>
                    <span class="v2-item__meta">{fmtDate(ep.data.date)} · {ep.data.duration}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="v2-col">
          <div class="v2-col__head"><h3 class="h3">Insights</h3><a class="link-arrow" href="/insights/">All insights →</a></div>
          <ul class="v2-list" data-stagger>
            {posts.map((p) => (
              <li>
                <a class="v2-item" href={`/insights/${p.id}/`} data-cursor="Read">
                  <span class="v2-item__img"><img src={postImage(p.data)} alt="" loading="lazy" /></span>
                  <span class="v2-item__body">
                    <span class="v2-item__kick">{p.data.category}</span>
                    <span class="v2-item__title">{p.data.title}</span>
                    <span class="v2-item__meta">{fmtDate(p.data.date)} · {readingTime(p.body)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · BOOKS: featured + three more -->
  {featuredBook && (
    <section class="section v2-sec">
      <div class="container">
        <header class="v2-head">
          <span class="v2-head__n">03</span>
          <div><span class="eyebrow">Publications</span><h2 class="h2" data-split>On the <em>shelf</em></h2></div>
        </header>
        <div class="v2-books">
          <article class="v2-feature reveal">
            <div class="v2-feature__cover" data-tilt>
              {featuredBook.cover
                ? <img src={featuredBook.cover} alt={`Cover of ${featuredBook.title}`} />
                : <div class="v2-cover"><span class="v2-cover__y">{featuredBook.year}</span><span class="v2-cover__rule"></span><span class="v2-cover__t">{featuredBook.title}</span><span class="v2-cover__a">Dr. Nauman Niaz</span></div>}
            </div>
            <div class="v2-feature__body">
              <span class="tag tag--accent">Latest book · {featuredBook.year}</span>
              <h3 class="h2">{featuredBook.title}</h3>
              <p class="lede">{featuredBook.synopsis}</p>
              <div class="btn-row">
                {featuredBook.buy[0] && <Button href={featuredBook.buy[0].url} external>Buy</Button>}
                <a class="btn btn--ghost" href="/publications/">All {books.length} books</a>
              </div>
            </div>
          </article>
          <ul class="v2-shelf" data-stagger>
            {moreBooks.map((b) => (
              <li>
                <a href="/publications/" class="v2-shelf__item">
                  <span class="v2-shelf__y">{b.year}</span>
                  <span class="v2-shelf__t">{b.title}</span>
                  <span class="v2-shelf__p">{b.publisher || 'Dr. Nauman Niaz'}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- CAREER SNAPSHOT -->
  {snapshot.length > 0 && (
    <section class="section v2-sec section--dark v2-dark">
      <div class="container">
        <header class="v2-head">
          <span class="v2-head__n">04</span>
          <div><span class="eyebrow">Career snapshot</span><h2 class="h2" data-split>Three decades, <em>at a glance</em></h2></div>
          <a class="link-arrow v2-head__link" href="/about/">Full timeline →</a>
        </header>
        <ol class="v2-snap" data-stagger>
          {snapshot.map((t) => (
            <li data-field={t.field}>
              <span class="v2-snap__y">{t.year}</span>
              <span class="v2-snap__t">{t.title}</span>
              <span class="v2-snap__f">{t.field}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- 7 · MEMORABILIA TEASER -->
  <section class="section v2-sec">
    <div class="container">
      <div class="v2-museum reveal" style={`--band:url(${defaultImages.museumBand})`}>
        <div class="v2-museum__text">
          <span class="eyebrow">The collection</span>
          <h2 class="h2">A lifetime of cricket history, <em>collected.</em></h2>
          <p>Begun at the age of twelve: pre-war and Edwardian cricket, signed and handwritten. A glimpse here; the full collection lives at the museum.</p>
          <div class="btn-row">
            <Button href={site.museum.url} variant="light" external>Explore the collection</Button>
            <a class="btn btn--ghost v2-museum__ghost" href="/memorabilia/">Highlights</a>
          </div>
        </div>
        {realMemo.length >= 3 ? (
          <ul class="v2-museum__thumbs" aria-hidden="true">
            {realMemo.slice(0, 3).map((m) => <li><Media src={m.image} alt="" ratio="3 / 4" dark /></li>)}
          </ul>
        ) : (
          <div class="v2-museum__single" aria-hidden="true"><img src="/images/pillar-memorabilia.webp" alt="" loading="lazy" /></div>
        )}
      </div>
    </div>
  </section>

  <!-- 8 · SELECTED VOICES (optional) -->
  {quotes.length > 0 && (
    <section class="section v2-sec" style="padding-top:0">
      <div class="container grid grid-3" data-stagger>
        {quotes.slice(0, 3).map((q) => (
          <blockquote class="card" style="padding:28px;margin:0"><p class="h3">“{q.quote}”</p><footer><strong>{q.name}</strong> · <span class="muted">{q.role}</span></footer></blockquote>
        ))}
      </div>
    </section>
  )}

  <!-- CONTACT -->
  <section class="section v2-sec" style="padding-top:0">
    <div class="container">
      <div class="v2-contact reveal">
        <div>
          <span class="eyebrow">Get in touch</span>
          <h2 class="h2">Media, speaking <em>&amp; publishing</em></h2>
        </div>
        <div class="v2-contact__routes">
          <a href="/contact/?type=media"><span>Media &amp; interviews</span><Arrow /></a>
          <a href="/contact/?type=speaking"><span>Speaking &amp; events</span><Arrow /></a>
          <a href="/contact/?type=publishing"><span>Publishing</span><Arrow /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── shared section header: number · eyebrow + title · optional link ── */
  .v2-sec { padding-block: clamp(56px, 7vw, 104px); }
  .v2-head { display: grid; grid-template-columns: auto 1fr auto; align-items: end; gap: 12px 28px; padding-bottom: 22px; margin-bottom: clamp(28px, 4vw, 44px); border-bottom: 1px solid var(--line); }
  .v2-head > div { display: grid; gap: 12px; }
  .v2-head__n { font-size: .82rem; font-weight: 600; color: var(--accent-deep); padding-bottom: 8px; font-variant-numeric: tabular-nums; }
  .v2-head__link { justify-self: end; margin-bottom: 8px; }
  .v2-dark .v2-head { border-color: rgba(255,255,255,.12); }

  /* ── 1 hero ── */
  .v2-hero { padding-top: clamp(112px, 12vw, 150px); }
  .v2-hero__grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(28px, 5vw, 80px); align-items: center; }
  .v2-hero__text { display: grid; gap: 22px; }
  .v2-hero__title { font-size: clamp(3rem, 7vw, 6.4rem); }
  .v2-hero__title :global(em) { color: var(--accent); }
  .v2-hero__quals { margin: -4px 0 0; font-size: .74rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; line-height: 1.8; color: var(--muted); max-width: 58ch; }
  .v2-hero .lede { margin: 0; }
  .v2-hero__photo { position: relative; margin: 0; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4 / 5; background: #120f0c; }
  .v2-hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%; }
  .v2-hero__badge { position: absolute; left: 16px; right: 16px; bottom: 16px; display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-radius: 20px; color: #fff; background: rgba(18,15,12,.45); border-color: rgba(255,255,255,.18); font-size: .9rem; line-height: 1.35; }
  .v2-hero__badge .muted { color: rgba(255,255,255,.65); font-size: .82rem; }
  .v2-hero__badge-k { font-size: 1.7rem; font-weight: 500; letter-spacing: -0.04em; color: var(--accent-glow); }

  /* ── 2 credentials ── */
  .v2-creds { list-style: none; margin: clamp(40px, 6vw, 72px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .v2-creds li { display: grid; gap: 4px; padding: 22px 24px; border-left: 1px solid var(--line); }
  .v2-creds li:first-child { border-left: 0; }
  .v2-creds strong { font-size: clamp(2rem, 3.4vw, 2.8rem); font-weight: 500; letter-spacing: -0.05em; line-height: 1; font-variant-numeric: tabular-nums; }
  .v2-creds span { color: var(--muted); font-size: .88rem; }

  /* ── 3 pillars ── */
  .v2-pillar :global(.media) { border-radius: 0; }
  .v2-pillar p { margin: 0; font-size: .92rem; }
  .v2-pillar__n { font-size: .74rem; color: var(--accent-deep); font-weight: 600; }
  .v2-more { margin-top: 8px; display: inline-flex; align-items: center; gap: 6px; font-size: .86rem; font-weight: 500; }
  .v2-more :global(svg) { width: 14px; transition: transform .4s var(--ease); }
  .v2-pillar:hover .v2-more :global(svg) { transform: translateX(4px); }

  /* ── 4+5 latest ── */
  .v2-latest__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 56px); }
  .v2-col__head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; }
  .v2-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .v2-item { display: grid; grid-template-columns: 132px 1fr; gap: 16px; align-items: center; padding: 10px; border-radius: 18px; background: var(--surface); border: 1px solid rgba(255,255,255,.7); transition: background .3s, transform .5s var(--ease); }
  .v2-item:hover { background: #fff; transform: translateX(4px); }
  .v2-item__img { position: relative; aspect-ratio: 16 / 11; border-radius: 12px; overflow: hidden; background: #2a2420; }
  .v2-item__img img { width: 100%; height: 100%; object-fit: cover; }
  .v2-item__play { position: absolute; right: 8px; bottom: 8px; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: #fff; display: grid; place-items: center; }
  .v2-item__play svg { width: 12px; margin-left: 2px; }
  .v2-item__body { display: grid; gap: 4px; min-width: 0; }
  .v2-item__kick { font-size: .72rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--accent-deep); }
  .v2-item__title { font-weight: 500; font-size: 1.04rem; letter-spacing: -0.02em; line-height: 1.25; }
  .v2-item__meta { font-size: .8rem; color: var(--muted); }

  /* ── 6 books ── */
  .v2-books { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(20px, 3vw, 40px); align-items: stretch; }
  .v2-feature { display: grid; grid-template-columns: 0.75fr 1fr; gap: clamp(20px, 4vw, 48px); align-items: center; padding: clamp(24px, 3.5vw, 44px); background: var(--surface); border-radius: var(--radius-lg); }
  .v2-feature__cover img, .v2-cover { width: 100%; aspect-ratio: 2 / 3; border-radius: 4px 8px 8px 4px; box-shadow: 18px 26px 44px -20px rgba(0,0,0,.55); object-fit: cover; }
  .v2-cover { background: #1a1512; color: #f3ede7; padding: 12% 10% 10% 14%; display: flex; flex-direction: column; container-type: inline-size; position: relative; }
  .v2-cover::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 7%; background: linear-gradient(90deg, rgba(0,0,0,.4), rgba(255,255,255,.1)); }
  .v2-cover__y { font-size: 7cqw; letter-spacing: .1em; opacity: .7; }
  .v2-cover__rule { width: 28%; height: 3px; background: var(--accent); margin: 12cqw 0 6cqw; }
  .v2-cover__t { font-family: var(--serif); font-size: 13cqw; line-height: 1.05; }
  .v2-cover__a { margin-top: auto; font-size: 6.4cqw; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }
  .v2-feature__body { display: grid; gap: 16px; }
  .v2-feature__body .lede { margin: 0; }
  .v2-shelf { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; align-content: stretch; }
  .v2-shelf__item { height: 100%; display: grid; gap: 4px; align-content: center; padding: 20px 22px; border-radius: var(--radius); border: 1px solid var(--line); transition: background .3s, border-color .3s; }
  .v2-shelf__item:hover { background: var(--surface); border-color: var(--accent); }
  .v2-shelf__y { font-size: .76rem; font-weight: 600; color: var(--accent-deep); }
  .v2-shelf__t { font-family: var(--serif); font-size: 1.35rem; line-height: 1.15; }
  .v2-shelf__p { font-size: .82rem; color: var(--muted); }

  /* ── career snapshot ── */
  .v2-dark { border-radius: var(--radius-lg); margin-inline: clamp(8px, 1.4vw, 20px); }
  .v2-snap { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 0; position: relative; }
  .v2-snap::before { content: ''; position: absolute; left: 0; right: 0; top: 9px; height: 1px; background: rgba(255,255,255,.18); }
  .v2-snap li { position: relative; display: grid; gap: 6px; padding: 34px 18px 0 0; }
  .v2-snap li::before { content: ''; position: absolute; top: 3px; left: 0; width: 13px; height: 13px; border-radius: 50%; background: var(--dark); border: 3px solid var(--fc, var(--accent)); }
  .v2-snap li[data-field='Medicine'] { --fc: var(--f-medicine); }
  .v2-snap li[data-field='Writing'] { --fc: var(--f-writing); }
  .v2-snap li[data-field='Academia'] { --fc: var(--f-academia); }
  .v2-snap__y { font-size: 1.9rem; font-weight: 500; letter-spacing: -0.05em; color: var(--fc, var(--accent)); line-height: 1; }
  .v2-snap__t { font-size: .95rem; color: #e9e6e2; line-height: 1.35; }
  .v2-snap__f { font-size: .72rem; color: #8f8f96; text-transform: uppercase; letter-spacing: .08em; }

  /* ── 7 museum ── */
  .v2-museum {
    display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: center;
    padding: clamp(28px, 5vw, 64px); border-radius: var(--radius-lg); color: #fff; overflow: hidden;
    background: linear-gradient(90deg, rgba(12,10,8,.94) 0%, rgba(12,10,8,.7) 55%, rgba(12,10,8,.35) 100%), var(--band) center / cover no-repeat, var(--dark);
  }
  .v2-museum__text { display: grid; gap: 18px; }
  .v2-museum__text .eyebrow { color: #c9c3bd; }
  .v2-museum__text p { margin: 0; color: #c9c3bd; max-width: 46ch; }
  .v2-museum__ghost { background: rgba(255,255,255,.12) !important; color: #fff !important; }
  .v2-museum__thumbs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .v2-museum__thumbs li:nth-child(2) { transform: translateY(-18px); }
  .v2-museum__thumbs :global(.media) { border-radius: 14px; }
  .v2-museum__single { justify-self: end; width: min(100%, 340px); aspect-ratio: 4 / 5; border-radius: 18px; overflow: hidden; box-shadow: 0 30px 60px -30px rgba(0,0,0,.7); transform: rotate(2deg); }
  .v2-museum__single img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 860px) { .v2-museum__single { justify-self: start; width: min(100%, 280px); } }

  /* ── contact ── */
  .v2-contact { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(24px, 4vw, 56px); align-items: center; padding: clamp(28px, 4vw, 48px); border-radius: var(--radius-lg); background: var(--surface); }
  .v2-contact > div:first-child { display: grid; gap: 12px; }
  .v2-contact__routes { display: grid; }
  .v2-contact__routes a { display: flex; justify-content: space-between; align-items: center; padding: 18px 4px; border-bottom: 1px solid var(--line); font-size: 1.15rem; font-weight: 500; letter-spacing: -0.02em; transition: color .3s, padding .5s var(--ease); }
  .v2-contact__routes a:first-child { border-top: 1px solid var(--line); }
  .v2-contact__routes a:hover { color: var(--accent-deep); padding-left: 12px; }
  .v2-contact__routes :global(svg) { width: 18px; }

  /* ── responsive ── */
  @media (max-width: 1100px) {
    .v2-books { grid-template-columns: 1fr; }
    .v2-shelf { grid-template-columns: repeat(3, 1fr); }
    .v2-snap { grid-template-columns: repeat(3, 1fr); row-gap: 28px; }
    .v2-snap::before { display: none; }
  }
