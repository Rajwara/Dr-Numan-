---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Page not found" description="The page you were looking for could not be found.">
  <section class="nf container">
    <span class="nf__code" aria-hidden="true">404</span>
    <h1 class="h1" data-split>Off the <em>edge.</em></h1>
    <p class="lede">The page you were looking for has moved or no longer exists.</p>
    <Button href="/">Back to home</Button>
  </section>
</Base>
<style>
  .nf { min-height: 90svh; display: grid; align-content: center; justify-items: start; gap: 24px; padding-top: 120px; position: relative; }
  .nf__code { position: absolute; right: var(--gutter); bottom: 0; font-size: clamp(8rem, 30vw, 26rem); font-weight: 500; letter-spacing: -0.07em; line-height: .8; background: linear-gradient(180deg, rgba(17,17,19,.1), transparent); -webkit-background-clip: text; background-clip: text; color: transparent; z-index: -1; }
</style>
