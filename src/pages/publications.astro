---
import Base from '../layouts/Base.astro';
import BookWheel from '../components/BookWheel.astro';
import Media from '../components/Media.astro';
import Button from '../components/Button.astro';
import { books, articles } from '../data/site';
const outlets = [...new Set(articles.map((a) => a.outlet))].sort();
const topics = ['Cricket', 'History', 'Medicine'];
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const sorted = [...articles].sort((a, b) => b.date.localeCompare(a.date));
---
<Base title="Publications" description={`Books and articles by Dr. Nauman Niaz on cricket, medicine and history: ${books.length} books and ${articles.length}+ articles and columns.`}>
  <!-- 1.0 PAGE HEADER: book wheel banner (title + summary below it) -->
  <BookWheel />

  <!-- 2.0 BOOKS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Books</span><h2 class="h2" data-split>The <em>books</em></h2></div>
        <p class="lede reveal" style="margin:0;max-width:34ch">Author of {books.length} books and {articles.length}+ articles on cricket, medicine and history.</p>
      </div>
      <div class="books">
        {books.map((b, i) => (
          <article class="bk reveal" id={`book-${i + 1}`}>
            <div class="bk__cover" data-tilt><Media src={b.cover} alt={`Cover of ${b.title}`} label="Book cover" ratio="2 / 3" dark /></div>
            <div class="bk__body">
              <span class="muted">{b.publisher} · {b.year}</span>
              <h3 class="h2">{b.title}</h3>
              <p class="lede">{b.synopsis}</p>
              <div class="btn-row">
                {b.buy.map((l, i) => <Button href={l.url} variant={i === 0 ? 'dark' : 'ghost'} size="sm" external>Buy · {l.label}</Button>)}
                {b.excerpt && <a class="link-arrow" href={b.excerpt}>Read an excerpt</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3.0 ARTICLES & COLUMNS (link out, never republish) -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Articles &amp; columns</span><h2 class="h2" data-split>Published <em>elsewhere</em></h2></div>
      </div>
      <div class="art-filters">
        <div class="filters" role="group" aria-label="Filter by topic">
          <button class="chip" type="button" aria-pressed="true" data-topic="">All topics</button>
          {topics.map((t) => <button class="chip" type="button" aria-pressed="false" data-topic={t}>{t}</button>)}
        </div>
        <label><span class="sr-only">Filter by outlet</span>
          <select data-outlet><option value="">All outlets</option>{outlets.map((o) => <option>{o}</option>)}</select>
        </label>
      </div>
      <ul class="rows arts" style="list-style:none;margin:0;padding:0">
        {sorted.map((a) => (
          <li data-art data-t={a.topic} data-o={a.outlet}>
            <a class="row" href={a.url} target="_blank" rel="noopener noreferrer">
              <span><span class="row__title">{a.title} ↗</span><br /><span class="row__meta">{a.outlet} · {a.topic}</span></span>
              <span class="row__meta">{fmt(a.date)}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="muted" data-art-none hidden>No articles match these filters.</p>
    </div>
  </section>

  <!-- 4.0 Academic papers: listed on Medicine & Academia (not duplicated) -->
  <section class="section--tight">
    <div class="container papers-link reveal">
      <div><span class="eyebrow">Academic papers</span><p class="lede" style="margin:12px 0 0">Peer-reviewed research is listed with his academic work.</p></div>
      <a class="link-arrow" href="/medicine-academia/#research">See research &amp; papers →</a>
    </div>
  </section>

  <!-- 5.0 Guest contributions live in Insights under the 'Guest' category -->

  <!-- 6.0 CTA -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="cta-band reveal">
        <span class="eyebrow">Insights</span>
        <h2 class="h2">Fresh writing, <em>published here first.</em></h2>
        <div><Button href="/insights/" variant="light">Read his latest Insights</Button></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .books { display: grid; gap: 24px; }
  .bk { scroll-margin-top: 110px; }
  .bk { display: grid; grid-template-columns: 220px 1fr; gap: clamp(24px, 5vw, 72px); align-items: center; padding: clamp(24px, 3vw, 40px); background: var(--surface); border-radius: var(--radius-lg); }
  .bk__cover :global(.media) { border-radius: 8px; box-shadow: 20px 30px 50px -28px rgba(0,0,0,.55); }
  .bk__body { display: grid; gap: 16px; }
  .bk__body .lede { margin: 0; }
  @media (max-width: 680px) { .bk { grid-template-columns: 1fr; } .bk__cover { max-width: 180px; } }

  .art-filters { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
  .art-filters .chip { color: #ddd; border-color: rgba(255,255,255,.2); }
  .art-filters .chip[aria-pressed='true'] { background: #fff; color: var(--ink); }
  .art-filters select { height: 40px; padding: 0 18px; border-radius: 999px; background: var(--dark-2); color: #eee; border: 1px solid rgba(255,255,255,.2); font: inherit; font-size: .88rem; }
  .arts .row:hover .row__title { color: var(--accent); }
  .papers-link { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px; padding: 32px 0; border-block: 1px solid var(--line); }
</style>
<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-art]'));
  const none = document.querySelector<HTMLElement>('[data-art-none]')!;
  const outlet = document.querySelector<HTMLSelectElement>('[data-outlet]')!;
  let topic = '';
  const apply = () => {
    let n = 0;
    rows.forEach((r) => { const ok = (!topic || r.dataset.t === topic) && (!outlet.value || r.dataset.o === outlet.value); r.hidden = !ok; if (ok) n++; });
    none.hidden = n > 0;
  };
  document.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-topic]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    topic = b.dataset.topic!; apply();
  }));
  outlet.addEventListener('change', apply);
</script>
