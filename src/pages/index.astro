---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Media from '../components/Media.astro';
import PostCard from '../components/PostCard.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import Arrow from '../components/Arrow.astro';
import LatestInsights from '../components/LatestInsights.astro';
import { site, postnominals, credentials, pillars, books, memorabilia, quotes, networks } from '../data/site';
import { byDate } from '../scripts/util';

const episodes = (await getCollection('conversations')).sort(byDate);
const posts = (await getCollection('insights')).sort(byDate);
const latestEp = episodes[0];
const featuredBook = books.find((b) => b.featured);
const word = site.shortName.toUpperCase().split('');
const isYear = (v: string) => /^\d{4}$/.test(v); // years don't count up
---
<Base
  title={site.name}
  description={`${site.name}: ${site.descriptor} Broadcasting, books, sports medicine, academia and the Conversations series.`}
>
  <!-- 1.0 HERO -->
  <section class="hero" data-hero>
    <!-- Art-directed banner: tall photo for portrait screens (phones, upright tablets), wide photo otherwise -->
    <div class="hero__media" data-hero-portrait>
      <picture>
        <source media="(max-aspect-ratio: 1/1)" type="image/webp" srcset="/images/hero-mobile-640.webp 640w, /images/hero-mobile-941.webp 941w" sizes="100vw" />
        <source media="(max-aspect-ratio: 1/1)" srcset="/images/hero-mobile-640.jpg 640w, /images/hero-mobile-941.jpg 941w" sizes="100vw" />
        <source type="image/webp" srcset="/images/hero-desktop-1200.webp 1200w, /images/hero-desktop-1672.webp 1672w" sizes="100vw" />
        <img
          src="/images/hero-desktop-1672.jpg"
          srcset="/images/hero-desktop-1200.jpg 1200w, /images/hero-desktop-1672.jpg 1672w"
          sizes="100vw" width="1672" height="941"
          alt="Portrait of Dr. Nauman Niaz" fetchpriority="high" decoding="async"
        />
      </picture>
    </div>
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="hero__word" data-hero-word aria-hidden="true">
      {word.map((l) => <span>{l}</span>)}
    </div>

    <div class="container hero__grid">
      <div class="hero__left">
        <span class="eyebrow" data-hero-eyebrow>Physician · Broadcaster · Author · Historian</span>
        <h1 class="display hero__title" data-hero-title data-split>Dr. Nauman <br class="hero__br" /><em>Niaz</em></h1>
        <p class="hero__quals" data-hero-eyebrow>{postnominals.join(' • ')}</p>
        <div class="hero__sub" data-hero-sub>
          <p class="hero__desc">{site.descriptor}</p>
          <div class="btn-row">
            <Button href="/about/" variant="light">About Dr. Niaz</Button>
            <a class="btn btn--ghost" href={latestEp ? `/conversations/${latestEp.id}/` : '/conversations/'}>Latest Conversation</a>
          </div>
        </div>
      </div>

      <div class="hero__right">
        {latestEp && (
          <a class="hero__card glass" href={`/conversations/${latestEp.id}/`} data-hero-card data-cursor="Watch">
            <div class="hero__card-thumb">
              <span class="hero__card-glyph">N<sup>®</sup></span>
            </div>
            <div class="hero__card-body">
              <span class="hero__card-kicker">Latest conversation · {latestEp.data.duration}</span>
              <strong>{latestEp.data.title}</strong>
              <span class="muted">with {latestEp.data.guest}</span>
              <span class="hero__card-progress"><i></i></span>
            </div>
            <span class="hero__card-play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg></span>
          </a>
        )}
        <div class="hero__side" data-hero-side>
          <span class="hero__side-h">On air with</span>
          <ul>{networks.slice(0, 6).map((n) => <li>{n}</li>)}</ul>
        </div>
      </div>
    </div>

    <div class="container hero__barwrap">
      <div class="hero__bar glass" data-hero-bar>
        <span>• {credentials[0].value} {credentials[0].label}</span>
        <span>• Based in {site.location}</span>
        <a href="#credentials" class="hero__scroll">Scroll down <span><Arrow dir="down" /></span></a>
      </div>
    </div>
  </section>

  <!-- marquee of four roles -->
  <div class="roles" aria-hidden="true">
    <div class="marquee">
      {[0, 1].map(() => (
        <div class="marquee__track">
          {['Physician', 'Broadcaster', 'Author', 'Cricket Historian', 'Academic', 'Collector'].map((r) => (
            <span class="roles__item">{r}<i>✦</i></span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- 2.0 CREDENTIALS STRIP -->
  <section class="section--tight" id="credentials">
    <div class="container">
      <ul class="creds" data-stagger>
        {credentials.map((c) => (
          <li><strong data-count={isYear(c.value) ? undefined : ''}>{c.value}</strong><span>{c.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3.0 FOUR PILLARS -->
  <section class="section" style="padding-top:clamp(40px,5vw,72px)">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Four disciplines, one career</span>
          <h2 class="h2" data-split>Medicine, the microphone, <em>the page</em> and the archive.</h2>
        </div>
      </div>
      <div class="grid grid-4" data-stagger>
        {pillars.map((p, i) => (
          <a class="card pillar zoom" href={p.href} data-tilt data-cursor="Explore">
            <Media src={p.image} label={`${p.title} image`} ratio="4 / 5" dark={i % 2 === 0} />
            <div class="pillar__body">
              <span class="pillar__n">0{i + 1}</span>
              <h3 class="h3">{p.title}</h3>
              <p class="muted">{p.text}</p>
              <span class="pillar__go"><Arrow /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4.0 LATEST CONVERSATIONS -->
  <section class="section section--dark conv">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Podcast &amp; vlog</span>
          <h2 class="h2" data-split>Latest <em>Conversations</em></h2>
        </div>
        <Button href="/conversations/" variant="light">All episodes</Button>
      </div>
      <div class="grid grid-3" data-stagger>
        {episodes.slice(0, 3).map((ep) => <EpisodeCard ep={ep} />)}
      </div>
    </div>
  </section>

  <!-- 5.0 LATEST INSIGHTS (design + motion from stay-on-course-section.html) -->
  <LatestInsights posts={posts.slice(0, 3)} />

  <!-- 6.0 FEATURED BOOK (optional) -->
  {featuredBook && (
    <section class="section--tight">
      <div class="container">
        <div class="book">
          <div class="book__cover" data-parallax="0.15">
            <Media src={featuredBook.cover} alt={`Cover of ${featuredBook.title}`} label="Book cover" ratio="2 / 3" dark />
          </div>
          <div class="book__text">
            <span class="eyebrow">Featured book · {featuredBook.year}</span>
            <h2 class="h2" data-split>{featuredBook.title}</h2>
            <p class="lede">{featuredBook.synopsis}</p>
            <div class="btn-row">
              {featuredBook.buy[0] && <Button href={featuredBook.buy[0].url} external>Buy</Button>}
              <a class="btn btn--ghost" href="/publications/">All publications</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 7.0 MEMORABILIA TEASER -->
  <section class="section memo">
    <div class="memo__word" aria-hidden="true" data-drift="-18">The Collection · The Collection ·</div>
    <div class="container">
      <div class="memo__grid" data-stagger>
        {memorabilia.slice(0, 4).map((m, i) => (
          <figure class:list={['memo__item', 'zoom', `memo__item--${i}`]}>
            <Media src={m.image} alt={m.caption} label="Collection photo" ratio={i === 1 ? '3 / 4' : '4 / 5'} dark />
          </figure>
        ))}
      </div>
      <div class="memo__cta reveal">
        <h2 class="h2">Explore the collection <em>at the museum.</em></h2>
        <Button href={site.museum.url} external>Visit {site.museum.name}</Button>
      </div>
    </div>
  </section>

  <!-- 8.0 SELECTED VOICES (optional) -->
  {quotes.length > 0 && (
    <section class="section">
      <div class="container grid grid-3" data-stagger>
        {quotes.slice(0, 3).map((q) => (
          <blockquote class="card quote"><p>“{q.quote}”</p><footer><strong>{q.name}</strong><span class="muted">{q.role}</span></footer></blockquote>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  /* ── HERO ──
     Full-bleed photo banner, art-directed per screen shape:
       • desktop (≥1280, landscape): text left, portrait centre, glass card right
       • tablet landscape / small laptop (900–1279): photo nudged right, card hidden
       • portrait screens (phones, upright tablets): tall photo, text anchored at the bottom */
  .hero {
    position: relative; min-height: max(720px, 100svh); margin: 10px; border-radius: var(--radius-lg);
    padding-top: 120px; overflow: hidden; display: flex; flex-direction: column; isolation: isolate;
    background: #120f0c; color: #fff;
  }
  .hero__media { position: absolute; inset: 0; z-index: 0; transform-origin: 50% 100%; }
  .hero__media picture, .hero__media img { width: 100%; height: 100%; display: block; }
  .hero__media img { object-fit: cover; object-position: 50% 18%; }
  .hero__shade {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(180deg, rgba(10,8,6,.55) 0%, rgba(10,8,6,0) 22%),
      linear-gradient(90deg, rgba(10,8,6,.6) 0%, rgba(10,8,6,.15) 38%, rgba(10,8,6,0) 55%),
      linear-gradient(0deg, rgba(10,8,6,.85) 0%, rgba(10,8,6,0) 32%);
  }
  .hero__word {
    position: absolute; left: 0; right: 0; bottom: -2%; z-index: 2; display: flex; justify-content: center; overflow: hidden; pointer-events: none;
    font-size: clamp(8rem, 30vw, 30rem); font-weight: 500; letter-spacing: -0.06em; line-height: 0.82;
  }
  .hero__word span {
    display: inline-block;
    background: linear-gradient(180deg, rgba(255,255,255,.28) 0%, rgba(255,255,255,.08) 55%, rgba(255,255,255,0) 90%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero__grid { position: relative; z-index: 3; flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; padding-top: clamp(24px, 5vh, 64px); }
  .hero__left { display: grid; gap: 24px; max-width: 560px; }
  .hero .eyebrow { color: rgba(255,255,255,.85); }
  .hero__title { font-size: clamp(3.2rem, 6vw, 6rem); text-shadow: 0 2px 30px rgba(0,0,0,.25); }
  .hero__title :global(em) { color: var(--accent); }
  .hero__br { display: none; }
  @media (min-width: 1280px) and (min-aspect-ratio: 1/1) { .hero__br { display: inline; } }
  .hero__quals { margin: -6px 0 0; font-size: .7rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; line-height: 1.7; color: rgba(255,255,255,.7); max-width: 52ch; }
  .hero__sub { display: grid; gap: 28px; }
  .hero__desc { margin: 0; font-size: 1.05rem; color: rgba(255,255,255,.82); max-width: 32ch; }
  .hero .btn--ghost { background: rgba(255,255,255,.14); color: #fff; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .hero .btn--ghost:hover { background: rgba(255,255,255,.24); }

  .hero__right { display: grid; justify-items: end; gap: 40px; }
  .hero__card {
    display: grid; grid-template-columns: 112px 1fr; gap: 16px; padding: 12px; width: min(370px, 100%); position: relative;
    background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.16); color: #fff;
    transition: transform .6s var(--ease), background .4s;
  }
  .hero__card:hover { background: rgba(255,255,255,.14); }
  .hero__card-thumb { aspect-ratio: 1; border-radius: 22px; background: #0b0a09; color: #fff; display: grid; place-items: center; position: relative; overflow: hidden; }
  .hero__card-thumb::after { content: ''; position: absolute; inset: auto -30% -50% -30%; height: 80%; background: radial-gradient(closest-side, rgba(232,113,28,.6), transparent); }
  .hero__card-glyph { font-size: 2.6rem; font-weight: 600; letter-spacing: -0.06em; position: relative; z-index: 1; }
  .hero__card-glyph sup { font-size: .8rem; }
  .hero__card-body { display: grid; align-content: center; gap: 4px; padding-right: 36px; }
  .hero__card-kicker { font-size: .7rem; color: rgba(255,255,255,.6); }
  .hero__card-body strong { font-size: 1.1rem; font-weight: 500; letter-spacing: -0.03em; line-height: 1.15; }
  .hero__card-body .muted { font-size: .82rem; color: rgba(255,255,255,.65); }
  .hero__card-progress { margin-top: 10px; height: 2px; background: rgba(255,255,255,.18); border-radius: 2px; overflow: hidden; }
  .hero__card-progress i { display: block; height: 100%; width: 40%; background: var(--accent); animation: prog 4s var(--ease) infinite; }
  @keyframes prog { 0% { transform: translateX(-100%); } 100% { transform: translateX(260%); } }
  .hero__card-play { position: absolute; top: 12px; right: 12px; width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,.14); display: grid; place-items: center; transition: background .3s, color .3s; }
  .hero__card:hover .hero__card-play { background: var(--accent); color: #fff; }
  .hero__card-play svg { width: 13px; margin-left: 2px; }
  .hero__side { text-align: right; display: grid; gap: 14px; }
  .hero__side-h { font-size: .82rem; font-weight: 500; }
  .hero__side ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, auto); justify-content: end; gap: 12px 22px; font-size: .78rem; color: rgba(255,255,255,.72); font-weight: 500; }

  .hero__barwrap { position: relative; z-index: 3; padding-bottom: 20px; }
  .hero__bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 22px; border-radius: 999px; font-size: .84rem; color: #fff; background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.16); }
  .hero__scroll { display: inline-flex; align-items: center; gap: 10px; }
  .hero__scroll span { width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,.15); display: grid; place-items: center; animation: bob 2.4s ease-in-out infinite; }
  .hero__scroll svg { width: 14px; }
  @keyframes bob { 50% { transform: translateY(4px); } }

  /* very wide screens: keep the face clear of the header */
  @media (min-aspect-ratio: 2/1) { .hero__media img { object-position: 50% 12%; } }

  /* small laptops & landscape tablets: move him right of the headline, drop the card */
  @media (max-width: 1279px) and (min-aspect-ratio: 1/1) {
    .hero__media img { object-position: 22% 18%; }
    .hero__card, .hero__side { display: none; }
    .hero__left { max-width: 470px; }
    .hero__title { font-size: clamp(3rem, 6.2vw, 4.8rem); }
    .hero__shade { background:
      linear-gradient(180deg, rgba(10,8,6,.55) 0%, rgba(10,8,6,0) 22%),
      linear-gradient(90deg, rgba(10,8,6,.75) 0%, rgba(10,8,6,.3) 40%, rgba(10,8,6,0) 60%),
      linear-gradient(0deg, rgba(10,8,6,.85) 0%, rgba(10,8,6,0) 32%); }
  }
  /* short landscape screens (phones turned sideways) */
  @media (max-height: 560px) and (min-aspect-ratio: 1/1) {
    .hero { min-height: 560px; padding-top: 90px; }
    .hero__grid { padding-top: 8px; }
    .hero__left { gap: 14px; }
    .hero__title { font-size: 2.8rem; }
    .hero__desc, .hero__quals { display: none; }
    .hero__media img { object-position: 0% 18%; }
  }

  /* portrait screens: phones and upright tablets use the tall photo */
  @media (max-aspect-ratio: 1/1) {
    .hero { min-height: 100svh; margin: 8px; padding-top: 0; }
    .hero__media img { object-position: 50% 0%; }
    .hero__shade { background:
      linear-gradient(180deg, rgba(10,8,6,.5) 0%, rgba(10,8,6,0) 14%),
      linear-gradient(0deg, rgba(10,8,6,.96) 0%, rgba(10,8,6,.82) 30%, rgba(10,8,6,.2) 52%, rgba(10,8,6,0) 64%); }
    .hero__grid { grid-template-columns: 1fr; align-items: end; padding-top: 0; padding-bottom: 20px; }
    .hero__left { max-width: 640px; gap: 18px; }
    .hero__title { font-size: clamp(2.9rem, 12vw, 5.6rem); }
    .hero__desc { font-size: 1rem; }
    .hero__right { display: none; }
    .hero__word { bottom: auto; top: 33%; font-size: 36vw; z-index: 1; }
    .hero__word span { background: linear-gradient(180deg, rgba(255,255,255,.14), rgba(255,255,255,0) 80%); -webkit-background-clip: text; background-clip: text; }
  }
  /* upright tablets: a little more air */
  @media (max-aspect-ratio: 1/1) and (min-width: 700px) {
    .hero__grid { padding-bottom: 40px; }
    .hero__sub { grid-template-columns: 1fr auto; align-items: end; gap: 24px; }
  }
  @media (max-width: 560px) {
    .hero__bar { padding: 12px 16px; font-size: .78rem; }
    .hero__bar span:nth-child(2) { display: none; }
    .hero .btn-row { gap: 10px; }
    .hero .btn { height: 48px; }
  }

  /* ── ROLES MARQUEE ── */
  .roles { padding: 26px 0; border-block: 1px solid var(--line); }
  .roles__item { display: inline-flex; align-items: center; gap: 56px; font-size: clamp(1.6rem, 3.4vw, 2.8rem); font-weight: 500; letter-spacing: -0.045em; white-space: nowrap; }
  .roles__item:nth-child(even) { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--muted); }
  .roles__item i { font-style: normal; font-size: .5em; color: var(--accent); }

  /* ── CREDENTIALS ── */
  .creds { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 24px; }
  .creds li { display: grid; gap: 4px; padding-top: 18px; border-top: 1px solid var(--ink); }
  .creds strong { font-size: clamp(2.2rem, 4vw, 3.4rem); font-weight: 500; letter-spacing: -0.05em; line-height: 1; font-variant-numeric: tabular-nums; }
  .creds span { color: var(--muted); font-size: .9rem; }
  @media (max-width: 520px) { .creds { grid-template-columns: repeat(2, 1fr); } }

  /* ── PILLARS ── */
  .pillar { position: relative; background: var(--surface); transform-style: preserve-3d; }
  .pillar__body { padding: 20px 22px 24px; display: grid; gap: 8px; position: relative; }
  .pillar__body p { margin: 0; font-size: .92rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pillar__n { font-size: .75rem; color: var(--muted); }
  .pillar__go { position: absolute; top: 18px; right: 18px; width: 38px; height: 38px; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; transition: background .3s, transform .5s var(--ease); }
  .pillar__go :global(svg) { width: 16px; }
  .pillar:hover .pillar__go { background: var(--accent); transform: rotate(45deg); }

  /* ── CONVERSATIONS (dark) ── */
  .conv { border-radius: var(--radius-lg); margin-inline: clamp(8px, 1.4vw, 20px); }
  .conv :global(.card) { background: var(--dark-2); border-color: rgba(255,255,255,.06); color: #eee; }
  .conv :global(.muted) { color: #9b9ba2; }
  .conv :global(.link-arrow) { color: var(--accent); }

  /* ── BOOK ── */
  .book { display: grid; grid-template-columns: 0.7fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; background: var(--surface); border-radius: var(--radius-lg); padding: clamp(28px, 5vw, 72px); overflow: hidden; }
  .book__cover { max-width: 340px; width: 100%; justify-self: center; }
  .book__cover :global(.media) { border-radius: 10px; box-shadow: 30px 40px 60px -30px rgba(0,0,0,.5); }
  .book__text { display: grid; gap: 22px; }
  @media (max-width: 760px) { .book { grid-template-columns: 1fr; } .book__cover { max-width: 220px; } }

  /* ── MEMORABILIA TEASER ── */
  .memo { position: relative; overflow: hidden; }
  .memo__word { position: absolute; top: 12%; left: 0; white-space: nowrap; font-size: clamp(6rem, 16vw, 15rem); font-weight: 500; letter-spacing: -0.06em; color: transparent; -webkit-text-stroke: 1px rgba(17,17,19,.12); pointer-events: none; }
  .memo__grid { position: relative; display: grid; grid-template-columns: 1fr 1.2fr 1fr 0.9fr; gap: 18px; align-items: end; }
  .memo__item { margin: 0; }
  .memo__item :global(.media) { border-radius: var(--radius); }
  .memo__item--1 { transform: translateY(-40px); }
  .memo__item--3 { transform: translateY(30px); }
  .memo__cta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px; margin-top: clamp(48px, 6vw, 80px); }
  .memo__cta .h2 { max-width: 16ch; }
  @media (max-width: 760px) { .memo__grid { grid-template-columns: 1fr 1fr; } .memo__item--1, .memo__item--3 { transform: none; } }

  .quote { padding: 32px; margin: 0; gap: 20px; }
  .quote p { font-size: 1.3rem; letter-spacing: -0.02em; line-height: 1.4; margin: 0; }
  .quote footer { display: grid; }
</style>
