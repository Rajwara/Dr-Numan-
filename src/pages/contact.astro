---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site, socials, speakingTopics, downloads, defaultImages } from '../data/site';
const types = [
  { value: 'media', label: 'Media' },
  { value: 'speaking', label: 'Speaking and events' },
  { value: 'publishing', label: 'Publishing' },
  { value: 'general', label: 'General' },
];
---
<Base title="Contact" description="Media, speaking and publishing enquiries for Dr. Nauman Niaz.">
  <PageHeader
    eyebrow="Contact"
    title="Get in touch"
    summary="Enquiries are handled by his office and answered within three working days. (Placeholder: confirm response time and who handles enquiries.)"
    image={defaultImages.contact}
    imageAlt="A writing desk at dusk with a sealed letter and a cricket ball"
  />

  <section class="section" style="padding-top:0">
    <div class="container contact">
      <!-- 2.0 FORM -->
      <form class="form glass reveal" action={site.formEndpoint} method="POST" data-form>
        <div class="form__row">
          <label><span>Name</span><input name="name" required autocomplete="name" /></label>
          <label><span>Email</span><input name="email" type="email" required autocomplete="email" /></label>
        </div>
        <label><span>Organisation</span><input name="organisation" autocomplete="organization" /></label>
        <fieldset>
          <legend>Enquiry type</legend>
          <div class="types">
            {types.map((t, i) => (
              <label class="type"><input type="radio" name="enquiry_type" value={t.label} data-type={t.value} required checked={i === 3} /><span>{t.label}</span></label>
            ))}
          </div>
        </fieldset>
        <label><span>Message</span><textarea name="message" rows="6" required></textarea></label>
        <!-- spam protection: honeypot (+ enable the provider's captcha/akismet) -->
        <label class="hp" aria-hidden="true">Leave empty<input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        <div class="form__foot">
          <button class="btn btn--dark" type="submit">Send enquiry<span class="btn__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="transform:rotate(45deg)"><path d="M7 17 17 7M8 7h9v9"/></svg></span></button>
          <p class="form__status muted" role="status" data-status></p>
        </div>
      </form>

      <!-- 3.0 DIRECT CHANNELS + 4.0 PRESS KIT + 5.0 SPEAKING TOPICS -->
      <aside class="side" data-stagger>
        <div class="side__block">
          <span class="eyebrow">Email</span>
          <a class="side__mail u-sweep" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div class="side__block">
          <span class="eyebrow">Social</span>
          <ul class="side__list">{socials.map((s) => <li><a class="u-sweep" href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></li>)}</ul>
        </div>
        {downloads.length > 0 && (
          <div class="side__block"><span class="eyebrow">Press kit</span><a class="link-arrow" href="/about/#downloads">Bio &amp; headshots →</a></div>
        )}
        {speakingTopics.length > 0 && (
          <div class="side__block">
            <span class="eyebrow">Speaking topics</span>
            <ul class="topics">{speakingTopics.map((t) => <li>{t}</li>)}</ul>
          </div>
        )}
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(32px, 5vw, 80px); align-items: start; }
  .form { padding: clamp(24px, 4vw, 48px); display: grid; gap: 20px; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .form label > span, .form legend { display: block; font-size: .82rem; font-weight: 500; margin-bottom: 8px; color: var(--ink-2); }
  .form input:not([type='radio']), .form textarea {
    width: 100%; font: inherit; font-size: 1rem; padding: 14px 18px; border-radius: 16px; border: 1px solid rgba(17,17,19,.14);
    background: rgba(255,255,255,.65); transition: border-color .3s, box-shadow .3s, background .3s; color: var(--ink);
  }
  .form input:focus, .form textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px rgba(232,113,28,.15); background: #fff; }
  .form fieldset { border: 0; padding: 0; margin: 0; }
  .types { display: flex; flex-wrap: wrap; gap: 8px; }
  .type input { position: absolute; opacity: 0; pointer-events: none; }
  .type span { display: inline-flex; align-items: center; height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid rgba(17,17,19,.16); font-size: .88rem; font-weight: 500; cursor: pointer; transition: .25s; margin: 0 !important; }
  .type input:checked + span { background: var(--ink); color: #fff; border-color: var(--ink); }
  .type input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .hp { position: absolute; left: -9999px; }
  .form__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .form__status { margin: 0; }
  .side { display: grid; gap: 36px; }
  .side__block { display: grid; gap: 12px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  .side__mail { font-size: clamp(1.3rem, 2.2vw, 1.8rem); font-weight: 500; letter-spacing: -0.03em; width: fit-content; word-break: break-all; }
  .side__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; }
  .topics { margin: 0; padding-left: 18px; display: grid; gap: 6px; color: var(--ink-2); }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .form__row { grid-template-columns: 1fr; } }
</style>
<script>
  // Pre-select enquiry type from ?type=speaking etc.
  const t = new URLSearchParams(location.search).get('type');
  if (t) document.querySelector<HTMLInputElement>(`[data-type="${CSS.escape(t)}"]`)?.click();

  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button')!;
    btn.disabled = true;
    status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error();
      form.reset();
      status.textContent = 'Thank you. Your enquiry has been sent.';
    } catch {
      status.textContent = 'Sorry, the message could not be sent. Please email us directly.';
    } finally {
      btn.disabled = false;
    }
  });
</script>
