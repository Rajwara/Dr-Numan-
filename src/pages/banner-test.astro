---
/**
 * Hidden test page: the full home page with the v2 banner photos
 * (public/images/hero-v2-*). Not in the menu, noindex, excluded from the sitemap.
 * Delete this file once a banner is chosen.
 */
import HomePage from '../components/HomePage.astro';
---
<HomePage
  noindex
  banner={{
    desktop: [{ file: '/images/hero-v2-desktop-1200', w: 1200 }, { file: '/images/hero-v2-desktop-1920', w: 1920 }],
    mobile: [{ file: '/images/hero-v2-mobile-640', w: 640 }, { file: '/images/hero-v2-mobile-1080', w: 1080 }],
    ratio: [1920, 1080],
  }}
/>
